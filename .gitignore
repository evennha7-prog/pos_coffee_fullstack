# =============================================================================
# COFFEE POS - COMPREHENSIVE PRODUCTION SECURITY & GITIGNORE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL SECURITY)
# -----------------------------------------------------------------------------
.env
.env*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.env.staging
*.env.prod
*.env.backup
*.env.dev
server_data/.env
server_data/.env*
server_data/*.env

# Allow sample templates only (No real passwords/secrets in repo)
!.env.example
!server_data/.env.example

# -----------------------------------------------------------------------------
# 2. PRIVATE KEYS, CERTIFICATES & CREDENTIALS
# -----------------------------------------------------------------------------
*.pem
*.key
*.pub
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
*.csr
*.kdbx
*.pwd
*.pass
*.jwt
*.secret

# SSH Keys
id_rsa
id_rsa.pub
id_dsa
id_ecdsa
id_ed25519
secring.gpg

# Cloud & API Service Account Credentials
service-account*.json
google-credentials*.json
firebase-adminsdk*.json
credentials*.json
client_secret*.json
token.json
.aws/
aws-credentials*

# -----------------------------------------------------------------------------
# 3. DATABASE DUMPS & LOCAL DATA FILES
# -----------------------------------------------------------------------------
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.tar.gz
*.bak
*.backup

# -----------------------------------------------------------------------------
# 4. USER UPLOADED FILES & LOCAL MEDIA STORAGE
# -----------------------------------------------------------------------------
upload/
uploads/
server_data/upload/*
server_data/src/upload/*
!server_data/upload/.gitkeep
!server_data/src/upload/.gitkeep

# -----------------------------------------------------------------------------
# 5. DEPENDENCIES & PACKAGE MANAGERS
# -----------------------------------------------------------------------------
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -----------------------------------------------------------------------------
# 6. BUILD OUTPUTS & FRAMEWORK CACHES
# -----------------------------------------------------------------------------
.next/
out/
build/
dist/
*/dist/
*.tsbuildinfo
next-env.d.ts
.vercel
.firebase/

# -----------------------------------------------------------------------------
# 7. LOGS & DIAGNOSTICS
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 8. TESTING & CODE COVERAGE
# -----------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output

# -----------------------------------------------------------------------------
# 9. OPERATING SYSTEM & TEMPORARY FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.tmp
*.temp

# -----------------------------------------------------------------------------
# 10. IDE & EDITOR SETTINGS
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
