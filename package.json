{
  "name": "coffee_pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,backend\" -c \"blue,green\" \"next dev --webpack\" \"npm --prefix server_data/src run dev\"",
    "dev:frontend": "next dev --webpack",
    "dev:backend": "npm --prefix server_data/src run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "npm --prefix server_data/src run db:migrate",
    "db:seeder": "npm --prefix server_data/src run db:seeder"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@shadcn/helpers": "^0.1.0",
    "@tabler/icons-react": "^3.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
