# =============================================================================
# BACKEND SERVER SECURITY & GITIGNORE (server_data)
# =============================================================================

# 1. Environment Secrets
.env
.env*
*.env
*.env.local
*.env.production
*.env.development
*.env.staging
!.env.example

# 2. Dependencies
node_modules/
src/node_modules/

# 3. Build & Compiler Outputs
dist/
build/
*.tsbuildinfo

# 4. Uploaded Files & Temporary Assets
upload/*
src/upload/*
!upload/.gitkeep
!src/upload/.gitkeep

# 5. Database Dumps & Local Data
*.sql
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.dump

# 6. Keys, Certificates & Credentials
*.pem
*.key
*.pub
*.crt
*.cert
*.pfx
*.p12
service-account*.json
credentials*.json
token.json

# 7. Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*

# 8. OS & Temp Files
.DS_Store
Thumbs.db
Desktop.ini
*~
*.tmp
*.temp
