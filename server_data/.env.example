# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_CONNECTION=mysql
DB_NAME=cofeepos_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_URL=mysql://root:your_mysql_password@localhost:3306/cofeepos_db

# Server Configuration
PORT=5000
NODE_ENV=development
LOCAL_DOMAIN=http://localhost:3000

# Authentication & Security
JWT_SECRET=change_this_to_a_secure_random_secret_string
JWT_LIFETIME=7d
COOKIE_EXPIRE=7
COOKIE_SAMESITE=lax

# Default Super Admin Seed Credentials
SUPER_USERNAME=superadmin
SUPER_EMAIL=super@coffee.com
SUPER_PASSWORD=your_secure_admin_password
